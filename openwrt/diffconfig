# OpenWrt 25.12 build config for Mercusys MR70X v1 (16 MB flash).
# Applied on top of `make defconfig`, see .github/workflows/build.yml.

CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_mercusys_mr70x-v1=y

# --- Image size tuning -------------------------------------------------------
# Bigger squashfs blocks compress noticeably better (default is 256 KiB).
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=1024
# Drop unused symbols from shared libraries (packages are fixed at build time).
CONFIG_USE_MKLIBS=y
# CONFIG_KERNEL_KALLSYMS is not set
# CONFIG_KERNEL_CRASHLOG is not set
# CONFIG_KERNEL_SWAP is not set
# CONFIG_KERNEL_DEBUG_FS is not set
# CONFIG_KERNEL_DEBUG_KERNEL is not set
# CONFIG_KERNEL_DEBUG_INFO is not set
# CONFIG_KERNEL_ELF_CORE is not set
# CONFIG_KERNEL_MAGIC_SYSRQ is not set
# CONFIG_KERNEL_PRINTK_TIME is not set
# CONFIG_KERNEL_PERF_EVENTS is not set
# CONFIG_KERNEL_FTRACE is not set
# CONFIG_KERNEL_IO_URING is not set
# CONFIG_KERNEL_KPROBES is not set
# CONFIG_KERNEL_AIO is not set
# CONFIG_KERNEL_FHANDLE is not set
# CONFIG_COLLECT_KERNEL_DEBUG is not set
# CONFIG_BUILD_LOG is not set

# No package manager: there is no room to install anything anyway.
# CONFIG_PACKAGE_apk-mbedtls is not set
# CONFIG_PACKAGE_luci-app-package-manager is not set
# CONFIG_PACKAGE_procd-ujail is not set

# No IPv6 on the LAN side: the tunnel is IPv4 only, and IPv6 would let
# clients reach blocked sites around it (AAAA answers are also filtered).
# CONFIG_PACKAGE_odhcp6c is not set
# CONFIG_PACKAGE_odhcpd-ipv6only is not set
# (luci-proto-ipv6 is pulled in by luci-light, it is tiny)

# --- Packages ----------------------------------------------------------------
CONFIG_PACKAGE_luci-light=y
CONFIG_LUCI_LANG_ru=y
CONFIG_PACKAGE_luci-i18n-base-ru=y
CONFIG_PACKAGE_luci-i18n-firewall-ru=y

# dnsmasq with nftset support for pbr domain policies
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq_full_dhcpv6 is not set
# CONFIG_PACKAGE_dnsmasq_full_dnssec is not set
# CONFIG_PACKAGE_dnsmasq_full_auth is not set
# CONFIG_PACKAGE_dnsmasq_full_ipset is not set
# CONFIG_PACKAGE_dnsmasq_full_conntrack is not set
# CONFIG_PACKAGE_dnsmasq_full_noid is not set
# CONFIG_PACKAGE_dnsmasq_full_broken_rtc is not set
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y
# CONFIG_PACKAGE_dnsmasq_full_tftp is not set

# Policy-based routing
CONFIG_PACKAGE_pbr=y
CONFIG_PACKAGE_luci-app-pbr=y
CONFIG_PACKAGE_luci-i18n-pbr-ru=y

# Xray TUN (the xray binary is built separately, see xray-slim/)
CONFIG_PACKAGE_kmod-tun=y

# AmneziaWG (feed: Slava-Shchipunov/awg-openwrt)
CONFIG_PACKAGE_kmod-amneziawg=y
CONFIG_PACKAGE_amneziawg-tools=y
CONFIG_PACKAGE_luci-proto-amneziawg=y
CONFIG_PACKAGE_luci-i18n-amneziawg-ru=y

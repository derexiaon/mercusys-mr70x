# zapret2 (nfqws2): DPI bypass for traffic that goes directly, without the VPN.
# Only domains from /etc/zapret2/hostlist.txt are handled; they are also taken
# out of the VPN lists (pbr), so they always go directly.
# After changes: /etc/init.d/zapret2 restart

config zapret2 'main'
	option enabled '1'
	# LAN device whose clients are handled (the router's own traffic, e.g. Xray to
	# the VPN server, is never touched)
	option lan_device 'br-lan'
	option qnum '200'
	option fwmark '0x40000000'
	# how many first packets of a connection go to nfqws2 (out / in)
	option packets_out '9'
	option packets_in '3'
	option tcp_ports '80,443'
	option udp_ports '443'
	# Discord voice and video (UDP)
	option discord_ports '50000-50099,19294-19344'
	# nfqws2 profiles, tried in order (the first one that matches wins).
	# <HOSTLIST> -> --hostlist=/etc/zapret2/hostlist.txt, <DISCORD_PORTS> -> discord_ports
	# If YouTube does not open, try other strategies: see README of the firmware (zapret2).
	list profile '--filter-tcp=443 --filter-l7=tls <HOSTLIST> --payload=tls_client_hello --lua-desync=fake:blob=fake_default_tls:tcp_md5:tcp_seq=-10000 --lua-desync=multidisorder:pos=1,midsld'
	list profile '--filter-tcp=80 --filter-l7=http <HOSTLIST> --payload=http_req --lua-desync=fake:blob=fake_default_http:tcp_md5 --lua-desync=multisplit:pos=method+2'
	list profile '--filter-udp=443 --filter-l7=quic <HOSTLIST> --payload=quic_initial --lua-desync=fake:blob=fake_default_quic:repeats=6'
	list profile '--filter-udp=<DISCORD_PORTS> --filter-l7=discord,stun --payload=discord_ip_discovery,stun --lua-desync=fake:blob=0x00000000000000000000000000000000:repeats=2'

{
	"luci-app-xray-link": {
		"description": "Grant access to Xray link setup",
		"read": {
			"file": {
				"/etc/xray/link": [ "read" ],
				"/etc/init.d/xray": [ "exec" ],
				"/etc/init.d/xray status": [ "exec" ],
				"/sbin/logread": [ "exec" ],
				"/sbin/logread -e xray -l 50": [ "exec" ]
			}
		},
		"write": {
			"file": {
				"/usr/bin/xray-link": [ "exec" ],
				"/usr/bin/xray-link *": [ "exec" ],
				"/etc/init.d/xray *": [ "exec" ],
				"/etc/init.d/pbr": [ "exec" ],
				"/etc/init.d/pbr restart": [ "exec" ]
			}
		}
	}
}

#!/bin/sh
# Build /etc/xray/config.json from share links and/or a subscription.
#
#   xray-link 'vless://...' ['hy2://...' ...]   save these links and apply
#   xray-link --sub 'https://...'              set the subscription URL ('' removes it)
#   xray-link --update                         re-download the subscription, apply if changed
#   xray-link --apply                          rebuild the config from saved links/subscription
#   xray-link --show                           print links, subscription and servers
#   xray-link --hwid [--new]                   print (or regenerate) the HWID sent with the subscription
#   xray-link --set LINKS SUB_URL SERVER [HWID] used by LuCI (LINKS: one per line, HWID: 1/0)
#
# Links: vless://, trojan://, ss://, hysteria2:// (hy2://). Several servers:
# Xray probes them and uses the fastest alive one (option server=auto).

. /lib/functions.sh

CONF_DIR=/etc/xray
LINKS_FILE=$CONF_DIR/links
SUB_FILE=$CONF_DIR/subscription
SERVERS_FILE=$CONF_DIR/servers
CONFIG=$CONF_DIR/config.json
GEN=/usr/share/xray-link/gen.uc

die() {
	echo "Ошибка: $*" >&2
	exit 1
}

xray_test() {
	GOMEMLIMIT=40MiB /usr/bin/xray run -test -c "$1" >"$2" 2>&1
}

save_links() {
	mkdir -p "$CONF_DIR"
	printf '%s\n' "$@" | tr -d '\r' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | grep '://' > "$LINKS_FILE.new"
	chmod 600 "$LINKS_FILE.new"
	mv "$LINKS_FILE.new" "$LINKS_FILE"
}

# Device ID for panels that limit devices per subscription (Remnawave, Marzban, HAPP
# style x-hwid): generated once and kept in /etc/config/xray.
get_hwid() {
	local hwid
	config_get hwid main hwid ''
	if [ -z "$hwid" ] || [ "$1" = new ]; then
		hwid="$(tr -d '-' < /proc/sys/kernel/random/uuid)"
		uci -q set xray.main.hwid="$hwid" && uci -q commit xray
		config_set main hwid "$hwid"
	fi
	echo "$hwid"
}

# returns 0 if the subscription changed, 2 if unchanged, 1 on error
fetch_sub() {
	local url ua tmp send os ver model

	config_get url main subscription ''
	config_get ua main sub_user_agent 'v2rayN/7.0'
	set --
	config_get_bool send main send_hwid 1
	if [ "$send" = 1 ]; then
		config_get os main device_os 'OpenWrt'
		config_get ver main os_version ''
		[ -n "$ver" ] || ver="$(. /etc/openwrt_release 2>/dev/null; echo "$DISTRIB_RELEASE")"
		config_get model main device_model ''
		[ -n "$model" ] || model="$(cat /tmp/sysinfo/model 2>/dev/null)"
		set -- --header "x-hwid: $(get_hwid)"
		# uclient-fetch refuses headers with empty values
		[ -n "$os" ] && set -- "$@" --header "x-device-os: $os"
		[ -n "$ver" ] && set -- "$@" --header "x-ver-os: $ver"
		[ -n "$model" ] && set -- "$@" --header "x-device-model: $model"
	fi

	if [ -z "$url" ]; then
		[ -f "$SUB_FILE" ] || return 2
		rm -f "$SUB_FILE"
		return 0
	fi

	tmp=/tmp/xray-sub.$$
	if ! uclient-fetch -q -T 30 -U "$ua" "$@" -O "$tmp" "$url" 2>/dev/null || [ ! -s "$tmp" ]; then
		rm -f "$tmp"
		echo "Не удалось скачать подписку: $url" >&2
		return 1
	fi

	if cmp -s "$tmp" "$SUB_FILE"; then
		rm -f "$tmp"
		return 2
	fi

	mkdir -p "$CONF_DIR"
	chmod 600 "$tmp"
	mv "$tmp" "$SUB_FILE"
	return 0
}

gen() {
	local out="$1" exclude="$2" src=""

	[ -s "$LINKS_FILE" ] && src="$src $LINKS_FILE"
	[ -s "$SUB_FILE" ] && src="$src $SUB_FILE"

	ucode "$GEN" out="$out" dns_port="$DNS_PORT" upstream_dns="$UPSTREAM_DNS" \
		server="$SERVER" max="$MAX_SERVERS" exclude="$exclude" $src
}

# Keep the connection to the VPN servers themselves out of the tunnel.
update_pbr() {
	local hosts old

	# pbr runs with IPv6 disabled: IPv6 server addresses are left out
	hosts="$(grep -v ':' "$1" | sort -u | tr '\n' ' ' | sed 's/ $//')"
	old="$(uci -q get pbr.mr70x_server.dest_addr)"
	[ "$hosts" = "$old" ] && return 1
	[ -n "$hosts" ] || return 1

	uci -q batch <<-EOF
		set pbr.mr70x_server=policy
		set pbr.mr70x_server.name='Xray server (direct)'
		set pbr.mr70x_server.interface='wan'
		set pbr.mr70x_server.dest_addr='$hosts'
		set pbr.mr70x_server.enabled='1'
		commit pbr
	EOF
	return 0
}

apply() {
	local tmp count total bad i changed=0 pbr_changed=0

	tmp="$(mktemp -d /tmp/xray-link.XXXXXX)" || die "mktemp"
	trap 'rm -rf "$tmp"' EXIT

	gen "$tmp" "" || die "не удалось разобрать ссылки"
	read count total < "$tmp/count"
	[ -s "$tmp/errors" ] && { echo "Пропущено:"; sed 's/^/  /' "$tmp/errors"; }
	[ "${count:-0}" -gt 0 ] || die "нет ни одного поддерживаемого сервера"

	echo "Проверка конфигурации ($count серв.)..."
	if ! xray_test "$tmp/test.json" "$tmp/test.log"; then
		# find the servers xray rejects and drop them
		bad=""
		i=1
		while [ "$i" -le "$total" ]; do
			if ! xray_test "$tmp/test-$i.json" "$tmp/test-$i.log"; then
				bad="$bad,$i"
				echo "Сервер $i отклонён: $(tail -n1 "$tmp/test-$i.log" | sed 's/.*> //')" >&2
			fi
			i=$((i + 1))
		done
		[ -n "$bad" ] || { cat "$tmp/test.log" >&2; die "xray отклонил конфигурацию"; }

		gen "$tmp" "$bad" || die "не удалось разобрать ссылки"
		read count total < "$tmp/count"
		[ "${count:-0}" -gt 0 ] || die "не осталось ни одного рабочего сервера"
		xray_test "$tmp/test.json" "$tmp/test.log" || { cat "$tmp/test.log" >&2; die "xray отклонил конфигурацию"; }
	fi

	mkdir -p "$CONF_DIR"
	if ! cmp -s "$tmp/config.json" "$CONFIG"; then
		cp "$tmp/config.json" "$CONFIG.new" && chmod 600 "$CONFIG.new" && mv "$CONFIG.new" "$CONFIG"
		changed=1
	fi
	cmp -s "$tmp/servers" "$SERVERS_FILE" || cp "$tmp/servers" "$SERVERS_FILE"
	update_pbr "$tmp/hosts" && pbr_changed=1

	echo "Серверы:"
	awk -F'\t' '{ printf "  %s. %s — %s (%s)\n", $1, $4, $3, $2 }' "$SERVERS_FILE"
	[ "$count" -gt 1 ] && [ "$SERVER" = auto ] && echo "Режим: автоматический выбор самого быстрого сервера"

	# Used by the CI smoke test (chroot without procd).
	[ -n "$XRAY_LINK_NO_RESTART" ] && return 0

	if [ "$changed" = 1 ] || ! /etc/init.d/xray running; then
		uci -q set xray.main.enabled=1 && uci -q commit xray
		/etc/init.d/xray enable
		/etc/init.d/xray restart
		echo "Xray перезапущен."
	else
		echo "Конфигурация не изменилась."
	fi

	if [ "$pbr_changed" = 1 ]; then
		# pbr downloads the lists, which can take a while: do it in background.
		( sleep 5; /etc/init.d/pbr restart ) >/dev/null 2>&1 </dev/null &
		echo "pbr перезапускается в фоне."
	fi
}

load_opts() {
	config_load xray
	config_get DNS_PORT main dns_port 5353
	config_get UPSTREAM_DNS main upstream_dns 1.1.1.1
	config_get SERVER main server auto
	config_get MAX_SERVERS main max_servers 10
}

set_opt() {
	if [ -n "$2" ]; then
		uci -q set "xray.main.$1=$2"
	else
		uci -q delete "xray.main.$1"
	fi
	uci -q commit xray
}

# Old single-link file from the first firmware versions.
[ -f "$LINKS_FILE" ] || [ ! -f "$CONF_DIR/link" ] || mv "$CONF_DIR/link" "$LINKS_FILE"

load_opts

case "$1" in
	--show)
		echo "Ссылки ($LINKS_FILE):"
		[ -s "$LINKS_FILE" ] && sed 's/^/  /' "$LINKS_FILE"
		echo "Подписка: $(uci -q get xray.main.subscription)"
		echo "Выбор сервера: $SERVER"
		echo "Серверы:"
		[ -s "$SERVERS_FILE" ] && awk -F'\t' '{ printf "  %s. %s — %s (%s)\n", $1, $4, $3, $2 }' "$SERVERS_FILE"
		;;
	--sub)
		set_opt subscription "$2"
		load_opts
		fetch_sub; [ $? = 1 ] && exit 1
		apply
		;;
	--update)
		[ -n "$(uci -q get xray.main.subscription)" ] || exit 0
		fetch_sub
		case $? in
			0) apply ;;
			1) exit 1 ;;
			2) echo "Подписка не изменилась." ;;
		esac
		;;
	--apply)
		apply
		;;
	--hwid)
		get_hwid "$([ "$2" = --new ] && echo new)"
		;;
	--set)
		save_links "$2"
		set_opt subscription "$3"
		set_opt server "$4"
		[ -n "$5" ] && set_opt send_hwid "$5"
		load_opts
		fetch_sub; [ $? = 1 ] && exit 1
		apply
		;;
	''|-h|--help)
		sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
		exit 1
		;;
	-*)
		die "неизвестный параметр $1"
		;;
	*)
		save_links "$@"
		apply
		;;
esac

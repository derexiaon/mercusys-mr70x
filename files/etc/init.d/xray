#!/bin/sh /etc/rc.common
# Xray (slim build) for Mercusys MR70X.
# Creates the xray0 TUN device (used by pbr as interface "xray") and a local
# DNS forwarder 127.0.0.1:<dns_port> that resolves through the tunnel.

USE_PROCD=1
START=85
STOP=15

PROG=/usr/bin/xray
DNSMASQ_DIR=/tmp/dnsmasq.d
DNSMASQ_SNIPPET=$DNSMASQ_DIR/xray.conf

is_ip() {
	case "$1" in
		*:*) return 0 ;;
		*[!0-9.]*|'') return 1 ;;
		*) return 0 ;;
	esac
}

server_hosts() {
	jsonfilter -i "$1" \
		-e '@.outbounds[*].settings.address' \
		-e '@.outbounds[*].settings.vnext[*].address' 2>/dev/null
}

sub_host() {
	local url
	config_get url main subscription ''
	[ -n "$url" ] && echo "$url" | sed 's#^[A-Za-z]*://##; s#^[^@/]*@##; s#[/:?].*##'
}

dnsmasq_restart() {
	/etc/init.d/dnsmasq restart >/dev/null 2>&1
}

# Point dnsmasq at xray once its DNS inbound is actually listening.
dns_on() {
	local conf="$1" dns_tunnel dns_port bootstrap
	config_get_bool dns_tunnel main dns_tunnel 1
	[ "$dns_tunnel" = 1 ] || { dns_off; return 0; }
	config_get dns_port main dns_port 5353
	config_get bootstrap main bootstrap_dns 77.88.8.8

	(
		hex="$(printf '%04X' "$dns_port")"
		i=0
		while ! grep -q "0100007F:$hex " /proc/net/udp 2>/dev/null; do
			i=$((i + 1))
			if [ $i -gt 30 ]; then
				logger -t xray "DNS inbound 127.0.0.1:$dns_port is not up, keeping the ISP DNS"
				exit 0
			fi
			sleep 1
		done

		mkdir -p "$DNSMASQ_DIR"
		{
			echo "# generated by /etc/init.d/xray"
			echo "no-resolv"
			echo "server=127.0.0.1#$dns_port"
			# Names that must be resolved without the tunnel (chicken-and-egg):
			# the VPN servers, the subscription server and NTP.
			for host in $(server_hosts "$conf") $(sub_host) pool.ntp.org; do
				is_ip "$host" || echo "server=/$host/$bootstrap"
			done
		} > "$DNSMASQ_SNIPPET.new"

		if cmp -s "$DNSMASQ_SNIPPET.new" "$DNSMASQ_SNIPPET"; then
			rm -f "$DNSMASQ_SNIPPET.new"
		else
			mv "$DNSMASQ_SNIPPET.new" "$DNSMASQ_SNIPPET"
			dnsmasq_restart
		fi
	) </dev/null >/dev/null 2>&1 &
}

dns_off() {
	[ -f "$DNSMASQ_SNIPPET" ] || return 0
	rm -f "$DNSMASQ_SNIPPET"
	dnsmasq_restart
}

start_service() {
	local enabled conf memlimit

	config_load xray
	config_get_bool enabled main enabled 1
	config_get conf main config /etc/xray/config.json
	config_get memlimit main memlimit 40MiB

	if [ "$enabled" != 1 ]; then
		dns_off
		return 0
	fi

	if [ ! -s "$conf" ]; then
		logger -t xray "no config $conf; paste a vless:// link in LuCI (Services -> Xray) or run: xray-link 'vless://...'"
		dns_off
		return 0
	fi

	# No "xray run -test" here: it opens the TUN device and would clash with
	# the running instance. xray-link validates configs before saving them.
	procd_open_instance
	procd_set_param command "$PROG" run -c "$conf"
	procd_set_param env GOMEMLIMIT="$memlimit" GOGC=50
	procd_set_param limits nofile="16384 16384"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file "$conf"
	procd_close_instance

	dns_on "$conf"
}

service_stopped() {
	dns_off
}

service_triggers() {
	procd_add_reload_trigger xray
}
